# ============================================================
# clipping-windows-worker — Configuración
# Copia este archivo a `.env` y rellena los valores reales.
# NUNCA subas `.env` a Git.
# ============================================================

# --- Identidad del worker ---
WORKER_ID=windows-gpu-worker-01

# --- API central (VPS) ---
API_BASE_URL=https://internal-api.example.com
API_TOKEN=CHANGE_ME

# --- Polling / Heartbeat ---
POLL_INTERVAL=5
HEARTBEAT_INTERVAL=30

# --- Concurrencia ---
# MVP: solo 1 job a la vez (WhisperX/FFmpeg consumen muchos recursos)
MAX_CONCURRENT_JOBS=1

# --- Directorios ---
WORKING_DIRECTORY=C:\ClippingWorker\data

# --- GPU / WhisperX ---
DEVICE=cuda
COMPUTE_TYPE=float16
# Si CUDA no está disponible, ¿fallar o usar CPU?
ALLOW_CPU_FALLBACK=false

# --- Limpieza ---
AUTO_CLEANUP=true
JOB_RETENTION_HOURS=24

# --- Render ---
# Framerate de salida por defecto. Se aplica como ``-r`` después del
# filtergraph para que clips con fuente nativo a 23.976/24/25/29.97
# no fallen la regla QA de ``min_fps >= 24``. Sobrescribible vía
# ``payload.fps`` en cada job.
RENDER_OUTPUT_FPS=30.0

# --- Logging ---
LOG_LEVEL=INFO

# --- Clip storage (paso 18) ---
# Raíz de pending_upload/ uploaded/ archived/ por campaña.
# Comentado = default C:\CODIANT\clipping\storage\clips (no dejar vacío).
# CLIP_STORAGE_ROOT=C:\CODIANT\clipping\storage\clips
# Per-campaign storage (empty = legacy layout above; mini PC: /srv/datos/clipping)
# STORAGE_ROOT=
# STORAGE_CLEANUP_ENABLED=false
# STORAGE_CLEANUP_DRY_RUN=true
# STORAGE_CLEANUP_INTERVAL=1800
# CLIP_RETENTION_DAYS=7
# DISK_HIGH_WATERMARK_PCT=80

# --- Binarios (vacío = buscar en PATH) ---
FFMPEG_PATH=
FFPROBE_PATH=

# --- gog CLI (descargas de Google Drive) ---
# Ruta a gog.exe (vacío = buscar `gog`/`gog.exe` en PATH).
GOG_PATH=
# Cuenta de Google autorizada en gog (vacío = la cuenta por defecto de gog).
GOG_ACCOUNT=
# Contraseña del keyring de gog (si el keyring es de tipo fichero).
GOG_KEYRING_PASSWORD=

# --- Drive sin gog (cookies de sesión, opcional) ---
# Alternativa a %APPDATA%\clipping-windows-worker\drive_session.json.
# DRIVE_COOKIES_JSON=   (JSON literal de cookies)
# DRIVE_COOKIES_FILE=   (ruta a un JSON de cookies)
# DRIVE_SID= / DRIVE_HSID= / DRIVE_SSID= / DRIVE_LSAP=

# --- Publicación: estado de idempotencia ---
# Carpeta donde se guarda cada publicación real (clip+plataforma) para no
# volver a subir en un reintento. Comentado = <WORKING_DIRECTORY>\publish_state (no dejar vacío).
# Debe persistir entre reinicios; borrar un fichero = permitir re-publicar.
# PUBLISH_STATE_DIR=C:\ClippingWorker\data\publish_state

# --- YouTube (Data API v3, OAuth de la cuenta del canal) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# private (default) | unlisted | public
YOUTUBE_PRIVACY=private
# Otras cuentas: mismo nombre + _ + clave en mayúsculas, en el entorno del proceso.
# Una cuenta distinta de default exige las tres. No se rellenan con las de default.
# account=yt2 -> YOUTUBE_CLIENT_ID_YT2, YOUTUBE_CLIENT_SECRET_YT2, YOUTUBE_REFRESH_TOKEN_YT2

# --- Instagram (Graph API, Reels) ---
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_IG_USER_ID=
# facebook (default, página vinculada, graph.facebook.com) | instagram (Instagram Login, graph.instagram.com)
INSTAGRAM_AUTH=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Versión de Graph. Vacío = v21.0
INSTAGRAM_GRAPH_VERSION=
# account=ig2 -> INSTAGRAM_ACCESS_TOKEN_IG2, INSTAGRAM_IG_USER_ID_IG2
# check_publish_creds lee INSTAGRAM_AUTH (facebook|instagram) e INSTAGRAM_GRAPH_VERSION.
# Si existe oauth_state/instagram_<cuenta>.json, usa su access_token (solo lectura).

# --- TikTok (Content Posting API) ---
# inbox (default): borrador en la app, scope video.upload.
# direct: publicación automática, scope video.publish.
# TIKTOK_MODE=inbox
TIKTOK_ACCESS_TOKEN=
# Refresco del access token (~24 h). Por cuenta: TIKTOK_CLIENT_KEY_<ACCOUNT>
# (igual para SECRET y REFRESH_TOKEN). El token nuevo se guarda en
# <WORKING_DIRECTORY>/oauth_state/tiktok_<cuenta>.json (modo 600), nunca aquí.
# Si la caducidad no está en ese fichero, se refresca antes de publicar.
# TikTok rota el refresh token: un solo token compartido entre el mini PC y
# el worker de Windows se invalida en el otro en cuanto uno refresca.
# Usa credenciales distintas por worker.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=
# account=studio -> TIKTOK_ACCESS_TOKEN_STUDIO
# Si existe oauth_state/tiktok_<cuenta>.json, el chequeo usa su access_token.
# SELF_ONLY (default) | MUTUAL_FOLLOW_FRIENDS | FOLLOWER_OF_CREATOR | PUBLIC_TO_EVERYONE
# En direct tiene que estar en privacy_level_options del creador.
# SELF_ONLY junto con una campaña de pago lo rechaza TikTok (brand_content_toggle).
TIKTOK_PRIVACY=SELF_ONLY

# --- Buffer (Instagram + TikTok) ---
# Con BUFFER_API_KEY, instagram y tiktok se publican por Buffer (GraphQL) y no
# por los uploaders directos. Buffer no acepta subida: descarga el mp4 desde
# BUFFER_PUBLIC_BASE_URL/<nombre>, que sirve BUFFER_PUBLIC_DIR (Tailscale Funnel).
# La copia pública se borra cuando Buffer marca el post como sent o error.
# BUFFER_API_KEY=
# BUFFER_CHANNEL_INSTAGRAM=
# BUFFER_CHANNEL_TIKTOK=
# account=ig2 -> BUFFER_CHANNEL_INSTAGRAM_IG2
# BUFFER_PUBLIC_DIR=/srv/datos/apps/clip-public
# BUFFER_PUBLIC_BASE_URL=https://<host>.ts.net:8443/c
# Espera máxima (s) hasta tener la URL pública (Content Rewards pide < 30 min).
# BUFFER_PUBLISH_TIMEOUT=1200
